# Copy this file to .env and fill in your values.

# --- LLM (required for agents to actually think) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# --- Database ---
# Zero-setup default (SQLite):
DATABASE_URL=sqlite:///./agentos.db
# Production (Postgres) example:
# DATABASE_URL=postgresql+psycopg2://agentos:agentos@localhost:5432/agentos

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true

# --- Vector store ---
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION=agentos_memory

# --- Auth ---
JWT_SECRET_KEY=change_this_to_a_random_64_char_hex_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- Orchestrator ---
MAX_PARALLEL_AGENTS=4
MAX_TASK_RETRIES=2
AGENT_TIMEOUT_SECONDS=60
